From 780125982bddc97e57825152492b1e3b8cafb629 Mon Sep 17 00:00:00 2001
From: Gary Ng <garyng.zhongbo@gmail.com>
Date: Mon, 19 Oct 2026 17:05:45 +0000
Subject: [PATCH] Read a kitty key that has no modifier field

The kitty keyboard protocol leaves out the modifier field when it is 1
(no modifiers), so a terminal in kitty mode sends a plain Escape as
CSI 27 u. tty_keys_extended_key wanted both fields and did not take it
for a key: panes got a literal ^[[27u, and popups lost Escape. Take a
key with one field as having modifier 1.
---
 tty-keys.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/tty-keys.c b/tty-keys.c
index d3a93f1..ccea2d7 100644
--- a/tty-keys.c
+++ b/tty-keys.c
@@ -1110,8 +1110,15 @@ tty_keys_extended_key(struct tty *tty, const char *buf, size_t len,
 		if (sscanf(tmp, "27;%u;%u", &modifiers, &number) != 2)
 			return (-1);
 	} else {
-		if (sscanf(tmp ,"%u;%u", &number, &modifiers) != 2)
+		switch (sscanf(tmp, "%u;%u", &number, &modifiers)) {
+		case 1:
+			modifiers = 1;	/* kitty leaves out a modifier of 1 */
+			break;
+		case 2:
+			break;
+		default:
 			return (-1);
+		}
 	}
 	*size = end + 1;
 
